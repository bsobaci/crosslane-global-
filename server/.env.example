# Server
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./data/crosslane.db

# Encryption key — MUST be exactly 64 hex characters (32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string_generated_as_above

# Admin API access key — protect all /api/admin routes
# Change this in production to a strong random value
ADMIN_API_KEY=crosslane-admin-dev-key

# Email (SMTP) — for automated access request confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@crosslaneglobal.com
SMTP_PASS=replace_me

# Webhooks — Slack + Telegram notifications on new leads
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude API — for AI-generated opportunity summaries
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# SAM.gov API — for automated procurement data ingestion
# Get key at: https://sam.gov/profile (free registration required)
SAM_GOV_API_KEY=

# CORS — allowed origins for API requests
# Production: set to your actual domain
# Development: comma-separated or just the local origin
CORS_ORIGIN=http://localhost:3001
